[Unit]
Description=MinIO Object Storage Daemon
Documentation=https://docs.min.io
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/minio server -C /etc/minio --address 127.0.0.1:9000 --console-address :9001 /usr/local/share/minio/
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
